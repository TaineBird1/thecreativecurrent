packages/agents/prompts.generated.ts
*.tsbuildinfo

# convex/_generated used to be ignored here as machine-specific noise. It has
# to be committed instead, because a Cloudflare Pages build has no Convex
# credentials and no way to produce it: `npx convex codegen` refuses without a
# configured deployment, and the local stub that lets `pnpm typecheck` run
# types everything as `any`, which `next build` then rejects as implicit-any.
#
# So the real files travel with the repo. scripts/check-generated.mjs refuses
# to let the stub be committed in their place — that would build a deployed
# site against types that describe nothing.
convex/CLAUDE.md
convex/CLAUDE.md
convex/AGENTS.md

# The parent repo ignores "logs" — the usual Node rule for log files — and that
# pattern matches ANY directory of that name, including the Logs screen at
# app/logs/. The page was silently never committed and 404'd on a fresh
# checkout while working perfectly here.
#
# Git will not descend into an excluded directory, so the directory has to be
# un-excluded before its contents can be.
!/app/logs/
!/app/logs/**

# Written by `next build`. Regenerated every time.
next-env.d.ts
